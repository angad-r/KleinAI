# Klein AI - Environment Configuration Template
# Copy this file to .env and insert your real API credentials
# NEVER commit your actual .env file or real API keys to GitHub!

# Google Gemini API Key (Get a key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily AI Search API Key (Get a key from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Default Model Selection
GEMINI_MODEL=gemini-flash-lite-latest
